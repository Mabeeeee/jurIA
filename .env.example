ANTHROPIC_API_KEY=
CHAINLIT_AUTH_SECRET=
JURIA_ENV=dev

# Machine peu puissante (ex: portable de vacances) : meme en dev, utilise
# l'API Claude (Haiku) au lieu d'Ollama, a condition qu'ANTHROPIC_API_KEY
# soit renseignee ci-dessus. Sans cle API, repli sur un modele Ollama plus
# leger que mistral (voir OLLAMA_MODEL_PETITE_CONFIG dans juria/chat.py).
# Sans effet sur Ollama si OLLAMA_MODEL est defini explicitement ci-dessous.
JURIA_PETITE_CONFIG=false

# Ollama (used when JURIA_ENV=dev and JURIA_PETITE_CONFIG can't use Anthropic)
# Laisser vide/non defini pour laisser JURIA_PETITE_CONFIG choisir automatiquement.
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434/v1
